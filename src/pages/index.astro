<style>
	
/* FATIMA INTRO */

.fatima-intro {
  position: relative;
  background: #F3F0E5;
  color: #414738;
  padding: 120px 8% 140px;
  overflow: hidden;
}

.intro-inner {
  max-width: 1150px;
  margin: auto;
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  align-items: center;
  gap: 100px;
}

/* AVATAR */

.avatar-side {
  position: relative;
  text-align: center;
}

.avatar-frame {
  position: relative;
  max-width: 390px;
  margin: auto;
  padding: 25px 20px 0;
  background: #E5E6D8;
  border-radius: 180px 180px 15px 15px;
  overflow: hidden;
}

.avatar-label {
  position: absolute;
  top: 25px;
  left: 0;
  width: 100%;
  font-size: 9px;
  letter-spacing: 3px;
  color: #697653;
  z-index: 2;
}

.fatima-avatar {
  width: 100%;
  display: block;
  margin-top: 25px;
  transition: transform .5s ease;
}

.avatar-frame:hover .fatima-avatar {
  transform: translateY(-8px) rotate(-2deg);
}

.avatar-bottom {
  display: flex;
  justify-content: space-between;
  background: #697653;
  color: #F3F0E5;
  padding: 16px 22px;
  font: italic 18px var(--serif);
  border-radius: 0 0 10px 10px;
}

.avatar-caption {
  font: italic 15px var(--serif);
  color: #697653;
  margin-top: 22px;
}

.avatar-sparkle {
  position: absolute;
  z-index: 3;
  color: #C99E9C;
  font-size: 35px;
  animation: float 4s ease-in-out infinite;
}

.sparkle-one {
  top: 15%;
  left: 0;
}

.sparkle-two {
  top: 30%;
  right: -10px;
  animation-delay: -2s;
}

.sparkle-three {
  bottom: 20%;
  left: -10px;
  animation-delay: -1s;
}

/* INTRO TEXT */

.intro-copy {
  max-width: 550px;
}

.section-kicker {
  font-size: 10px;
  letter-spacing: 3px;
  font-weight: 600;
  color: #879477;
}

.intro-copy h2 {
  font: 500 clamp(42px, 5vw, 68px)/1.15 var(--serif);
  letter-spacing: -2px;
  margin: 25px 0;
}

.intro-copy h2 span {
  color: #879477;
  font-style: italic;
}

.intro-copy > p {
  font-size: 14px;
  line-height: 2;
  color: #777D6C;
}

.little-note {
  display: inline-flex;
  align-items: center;
  gap: 15px;
  margin-top: 25px;
  padding: 12px 18px;
  border: 1px dashed #B4B99F;
  border-radius: 40px;
  font: italic 13px var(--serif);
  color: #697653;
}

/* SERVICES */

.services-area {
  max-width: 1150px;
  margin: 130px auto 0;
}

.services-heading {
  text-align: center;
  margin-bottom: 55px;
}

.services-heading h3 {
  font: 500 clamp(38px, 5vw, 55px) var(--serif);
  margin: 20px 0 10px;
}

.services-heading h3 span {
  color: #879477;
  font-style: italic;
}

.services-heading p {
  font-size: 13px;
  color: #858977;
}

.service-cards {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}

.service-card {
  position: relative;
  min-height: 270px;
  padding: 25px 22px;
  border-radius: 12px;
  transition: transform .35s ease, box-shadow .35s ease;
}

.service-card:hover {
  transform: translateY(-10px) rotate(-1deg);
  box-shadow: 0 15px 30px #41473812;
}

.card-sage { background: #E0E5D5; }
.card-pink { background: #F0DDD8; }
.card-yellow { background: #EDE7D2; }
.card-lilac { background: #E7E2EA; }

.service-icon {
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  background: #FFFFFF80;
  border-radius: 50%;
  font-size: 25px;
  color: #697653;
}

.service-number {
  position: absolute;
  right: 22px;
  top: 35px;
  font-size: 10px;
  color: #858977;
  letter-spacing: 2px;
}

.service-card h4 {
  font: 500 26px var(--serif);
  margin: 30px 0 12px;
  color: #414738;
}

.service-card p {
  font-size: 12px;
  line-height: 1.8;
  color: #707565;
}

.card-bottom {
  display: block;
  margin-top: 25px;
  font: italic 12px var(--serif);
  color: #697653;
}

/* SCROLL REVEAL */
/* SCROLL REVEAL */

.reveal {
  opacity: 1;
  transform: none;
}

.reveal.animate-reveal {
  opacity: 0;
  transform: translateY(25px);
  transition:
    opacity .8s ease,
    transform .8s ease;
}

.reveal.animate-reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

@media (prefers-reduced-motion: reduce) {
  .reveal.animate-reveal {
    opacity: 1;
    transform: none;
    transition: none;
  }
}

/* RESPONSIVE */

@media(max-width: 850px) {
  .intro-inner {
    grid-template-columns: 1fr;
    gap: 65px;
  }

  .avatar-frame {
    max-width: 340px;
  }

  .intro-copy {
    text-align: center;
    margin: auto;
  }

  .service-cards {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media(max-width: 500px) {
  .fatima-intro {
    padding: 80px 6%;
  }

  .service-cards {
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .service-card {
    min-height: 250px;
    padding: 18px 14px;
  }

  .service-card h4 {
    font-size: 21px;
  }

  .service-card p {
    font-size: 11px;
  }

  .services-area {
    margin-top: 90px;
  }
}

@media(prefers-reduced-motion: reduce) {
  .reveal {
    opacity: 1;
    transform: none;
    transition: none;
  }

  .avatar-sparkle {
    animation: none;
  }
}
</style>


