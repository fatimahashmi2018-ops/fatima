
---
const doodles = [
  { symbol: "✿", class: "doodle d1" },
  { symbol: "✧", class: "doodle d2" },
  { symbol: "♡", class: "doodle d3" },
  { symbol: "✳", class: "doodle d4" },
  { symbol: "⋆", class: "doodle d5" },
  { symbol: "❀", class: "doodle d6" },
  { symbol: "✦", class: "doodle d7" },
  { symbol: "୨୧", class: "doodle d8" },
];
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#778365" />
  <title>Fatima — A Little Story</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet" />
</head>

<body>
  <main>
    <section class="stage">
      <!-- Cream background revealed underneath -->
      <div class="revealed"></div>

      <!-- Main hero -->
      <div class="hero">

        <div class="top-note">✿ &nbsp; A LITTLE WORLD OF MY OWN &nbsp; ✿</div>

        <div class="name-container">
          <p class="little-heading">the story of</p>
          <h1>Fatima<span>.</span></h1>
          <p class="subtitle">CREATIVE SOUL · DEVELOPER · DREAMER</p>
        </div>

        <!-- Floating doodles -->
        {doodles.map((doodle) => (
          <span class={doodle.class} aria-hidden="true">
            {doodle.symbol}
          </span>
        ))}

        <!-- Cloud foreground -->
        <div class="cloud">
          <svg viewBox="0 0 1440 260" preserveAspectRatio="none"
            xmlns="http://www.w3.org/2000/svg">
            <path
              d="
                M0 115
                C45 90 85 85 130 110
                C165 35 250 30 300 95
                C355 40 420 50 465 105
                C510 35 600 40 650 100
                C710 35 790 40 840 105
                C900 45 980 35 1030 100
                C1085 30 1170 40 1215 105
                C1280 40 1360 45 1400 100
                C1420 90 1430 100 1440 110
                L1440 260 L0 260 Z"
              fill="#F3F0E5"
            />
          </svg>
        </div>

        <div class="scroll-note">
          <span>SCROLL TO EXPLORE</span>
          <span class="arrow">↓</span>
        </div>

      </div>
    </section>
  </main>

  <script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const cloud = document.querySelector(".cloud");
    const hero = document.querySelector(".hero");

    if (cloud && hero) {
      gsap.to(cloud, {
        y: "-100vh",
        ease: "none",
        scrollTrigger: {
          trigger: ".stage",
          start: "top top",
          end: "bottom bottom",
          scrub: 1,
        },
      });

      gsap.to(hero, {
        opacity: 0,
        ease: "none",
        scrollTrigger: {
          trigger: ".stage",
          start: "top top",
          end: "bottom bottom",
          scrub: 1,
        },
      });
    }
  </script>
</body>
</html>

<style>
  :root {
    --olive: #778365;
    --cream: #F3F0E5;
    --pink: #E8C4BD;
    --serif: "Playfair Display", Georgia, serif;
    --sans: "DM Sans", sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html, body {
    margin: 0;
    width: 100%;
    background: var(--cream);
    font-family: var(--sans);
    overflow-x: hidden;
  }

  .stage {
    position: relative;
    height: 200vh;
  }

  .revealed {
    position: absolute;
    inset: 0;
    background: var(--cream);
  }

  .hero {
    height: 100vh;
    height: 100svh;
    width: 100%;
    position: sticky;
    top: 0;
    background: var(--olive);
    color: var(--cream);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .top-note {
    position: absolute;
    top: 35px;
    font-size: 10px;
    letter-spacing: 3px;
    color: #E9E5D5;
  }

  .name-container {
    position: relative;
    z-index: 2;
    text-align: center;
    margin-bottom: 65px;
  }

  .little-heading {
    font: italic 24px var(--serif);
    margin-bottom: 0;
  }

  h1 {
    font: 500 clamp(90px, 17vw, 210px)/1 var(--serif);
    letter-spacing: -9px;
    margin: 10px 0 25px;
  }

  h1 span {
    color: var(--pink);
  }

  .subtitle {
    font-size: 10px;
    letter-spacing: 3px;
    color: #E9C7C0;
  }

  .doodle {
    position: absolute;
    color: var(--cream);
    z-index: 2;
    pointer-events: none;
    animation: float 5s ease-in-out infinite;
  }

  .d1 { top: 23%; left: 16%; font-size: 36px; color: var(--pink); }
  .d2 { top: 18%; right: 24%; font-size: 35px; animation-delay: -2s; }
  .d3 { top: 48%; left: 10%; font-size: 34px; animation-delay: -1s; }
  .d4 { top: 65%; right: 14%; font-size: 42px; color: var(--pink); animation-delay: -3s; }
  .d5 { top: 72%; left: 27%; font-size: 30px; animation-delay: -2s; }
  .d6 { top: 35%; right: 12%; font-size: 32px; animation-delay: -4s; }
  .d7 { top: 75%; right: 32%; font-size: 28px; animation-delay: -1s; }
  .d8 { top: 30%; left: 28%; font-size: 26px; color: var(--pink); animation-delay: -3s; }

  @keyframes float {
    0%, 100% { transform: translate(0, 0) rotate(-8deg); }
    50% { transform: translate(12px, -18px) rotate(10deg); }
  }

  .cloud {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 180px;
    z-index: 5;
    will-change: transform;
  }

  .cloud svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .scroll-note {
    position: absolute;
    z-index: 6;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: var(--olive);
    font-size: 9px;
    letter-spacing: 2px;
  }

  .arrow {
    font-size: 22px;
    animation: bounce 1.5s infinite;
  }

  @keyframes bounce {
    50% { transform: translateY(7px); }
  }

  @media(max-width: 600px) {
    h1 {
      letter-spacing: -5px;
      font-size: 19vw;
    }

    .d1 { left: 8%; }
    .d2 { right: 10%; }
    .d3 { left: 5%; }
    .d4 { right: 7%; }
    .d8 { left: 15%; }

    .cloud {
      height: 150px;
    }

    .top-note {
      font-size: 8px;
    }
  }

  @media(prefers-reduced-motion: reduce) {
    .doodle, .arrow {
      animation: none;
    }
  }
</style>


<!-- FATIMA INTRODUCTION SECTION -->

